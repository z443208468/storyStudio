+def get_assistant_response(conversation):
+    """Return the last non-empty text answer or fail instead of fabricating success."""
+    state = conversation.memory.chat_memory.dict()
+    messages = state.get("messages") if isinstance(state, dict) else None
+    if not isinstance(messages, list) or not messages:
+        raise ValueError("MODEL_RESPONSE_MESSAGES_MISSING")
+    last = messages[-1]
+    content = last.get("content") if isinstance(last, dict) else None
+    if not isinstance(content, str) or not content.strip():
+        raise ValueError("EMPTY_OR_NON_TEXT_MODEL_RESPONSE")
+    return content
